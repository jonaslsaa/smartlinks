{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smartlinks-runtime",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "s.jonaslsa.com", "custom_domain": true }],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "vars": {
    "ACTIVE_KEY_ID": "1",
    "AUTHOR_CA_KEY_ID": "1",
    "AUTHOR_CA_PUBLIC_KEY_1": "iIakS3SEmbDXHtqGGsDhiQTGgx8yB9G6orxyHyqAIwc",
    "LANDING_URL": "https://smartlinks.jonaslsa.com/",
    "RUNTIME_HOSTNAMES": ["s.jonaslsa.com"]
  },
  "ratelimits": [
    {
      "name": "EXECUTION_RATE_LIMITER",
      "namespace_id": "20260815",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "IDENTITY_RATE_LIMITER",
      "namespace_id": "20260816",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
