{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smartlinks-runtime",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "s.jonaslsa.com", "custom_domain": true }],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "vars": {
    "ACTIVE_KEY_ID": "1",
    "LANDING_URL": "https://sl.jonaslsa.com/"
  },
  "ratelimits": [
    {
      "name": "EXECUTION_RATE_LIMITER",
      "namespace_id": "20260815",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
