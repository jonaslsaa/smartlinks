{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smartlinks-runtime",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "vars": {
    "ACTIVE_KEY_ID": "1",
    "LANDING_URL": "https://sl.jonaslsa.com/"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
